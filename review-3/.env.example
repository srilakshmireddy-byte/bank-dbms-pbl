# Copy this file to .env and edit the values yourself (never commit .env or paste it anywhere).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bank_db
PORT=3000

# Secret used to sign login sessions. Use any long random string.
# (Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# If left empty, a random secret is generated at start-up and everyone is logged out on each restart.
JWT_SECRET=

# Show clickable demo logins on the login page (set to false for anything but a classroom demo).
DEMO_LOGINS=true
